# GEMINI_API_KEY: Required for Gemini AI API calls.
# Locally: set in .env.local (gitignored), read via dotenv. On Vercel: set
# in Project Settings > Environment Variables — never commit a real value
# here or anywhere else.
# Read ONLY by server.ts (Node) — deliberately not VITE_-prefixed so Vite's
# client bundler can never see it. See server.ts's file header.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: optional, defaults to gemini-2.5-flash if unset.
GEMINI_MODEL="gemini-2.5-flash"

# API_PORT: optional, the port server.ts listens on locally (default 8787).
# Vite's dev server proxies /api to this port — see vite.config.ts. Not
# used on Vercel (api/index.ts runs as a serverless function, no port to
# bind — see server.ts's isMainModule guard).
API_PORT="8787"

# APP_URL: The URL where this app is hosted. Currently unused by any code
# in this repo (no self-referential links/OAuth callbacks read it yet) —
# kept as a placeholder for when that's needed. On Vercel, prefer the
# platform-provided VERCEL_URL/VERCEL_PROJECT_PRODUCTION_URL env vars over
# hardcoding this, since those track preview/production deploys correctly.
APP_URL="MY_APP_URL"

# Supabase Configurations
VITE_SUPABASE_URL="MY_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# SUPABASE_SERVICE_ROLE_KEY: NOT read by any app code (server.ts only ever
# uses the anon key, to validate a caller's JWT — see server.ts's header).
# Only needed for admin/ops tooling (Supabase CLI, one-off scripts) — do
# not set it as a Vercel env var for the deployed app, since the running
# app never reads it and that only widens what a server compromise exposes.
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"
